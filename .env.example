NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx

# Session (legacy - akan dihapus setelah Clerk aktif)
KAALUPI_SESSION_SECRET=replace-with-a-long-random-secret

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # WAJIB untuk Studio + AI generate

# Midtrans
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email notifications (Gmail App Password, bukan password login biasa)
EMAIL_USER=kaalupicourses@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password

# AI - Anthropic Claude (untuk AI Generate Materi di Course Studio)
# Daftar di https://console.anthropic.com - dapat $5 free credit
ANTHROPIC_API_KEY=sk-ant-xxxx

# Vercel Cron secret (random string panjang)
CRON_SECRET=random-string-min-32-char

# Webhook automation (n8n / Make.com / Zapier endpoint)
# Optional - kalau kosong, cron tetep jalan tapi ngga forward
REENGAGE_WEBHOOK_URL=https://n8n.example.com/webhook/kaalupi-reengage
WEEKLY_DIGEST_WEBHOOK_URL=https://n8n.example.com/webhook/kaalupi-digest
